{
  "name": "ncdls-study",
  "version": "0.1.0",
  "private": true,
  "description": "挪车打螺丝学习源码、微信还原工程与可运行的本地网页版",
  "scripts": {
    "check": "node scripts/check.cjs",
    "resources": "node scripts/resources.cjs",
    "sync:resources": "node scripts/sync-resources.cjs",
    "build:wechat": "node scripts/build-wechat.cjs",
    "check:wechat": "node scripts/check-wechat.cjs",
    "decode:configs": "node scripts/decode-configs.cjs",
    "build:web": "node scripts/build-web.cjs",
    "check:web": "node scripts/check-web.cjs && node scripts/check-browser-compat.cjs",
    "serve:web": "node scripts/serve-web.cjs",
    "web": "npm run build:web && npm run serve:web",
    "serve:web:lan": "node scripts/serve-web.cjs --lan",
    "web:lan": "npm run build:web && npm run serve:web:lan",
    "build:mobile": "node web_mobile/scripts/build.cjs",
    "check:mobile": "node web_mobile/scripts/check.cjs && node scripts/check-browser-compat.cjs",
    "serve:mobile": "node web_mobile/scripts/serve.cjs",
    "serve:mobile:lan": "node web_mobile/scripts/serve.cjs --lan",
    "mobile": "npm run build:mobile && npm run serve:mobile",
    "mobile:lan": "npm run build:mobile && npm run serve:mobile:lan",
    "check:browser": "node scripts/check-browser-compat.cjs"
  },
  "engines": {
    "node": ">=18"
  }
}
